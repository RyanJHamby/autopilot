#!/bin/sh
# Runs what CI runs, before anything leaves this machine. Enable once per clone:  git config core.hooksPath .githooks
# (or: scripts/install-hooks). Skipping it is a deliberate, visible choice, never the default.
set -e
cd "$(git rev-parse --show-toplevel)"
if command -v uv >/dev/null 2>&1; then RUN="uv run"; else RUN=""; fi
echo "pre-push: ruff check ."
$RUN ruff check .
echo "pre-push: pytest -q"
$RUN pytest -q
