{
  "name": "autopilot-control",
  "url": "https://autopilot-control.vercel.app",
  "redirect_url": "https://autopilot-control.vercel.app/api/github/manifest",
  "callback_urls": ["https://autopilot-control.vercel.app/api/auth/callback"],
  "public": false,
  "default_permissions": {
    "metadata": "read",
    "contents": "read",
    "issues": "write",
    "pull_requests": "write",
    "checks": "read",
    "actions": "read",
    "actions_variables": "write"
  },
  "default_events": ["issues", "pull_request", "workflow_run"]
}
