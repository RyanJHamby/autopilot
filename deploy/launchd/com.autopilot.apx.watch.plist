<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The OWNER's watcher (a LaunchAgent, runs as you, not as apx): every 5 minutes it reads apx's world-readable status file and shows a
     LOCAL macOS notification if apx stopped or its last pass had a problem. No network, no email, no chat: only your own screen.
     Install:  cp deploy/launchd/com.autopilot.apx.watch.plist ~/Library/LaunchAgents/ && launchctl load ~/Library/LaunchAgents/com.autopilot.apx.watch.plist
     Remove:   launchctl unload ~/Library/LaunchAgents/com.autopilot.apx.watch.plist && rm ~/Library/LaunchAgents/com.autopilot.apx.watch.plist -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.autopilot.apx.watch</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>-m</string>
    <string>autopilot.apx.status</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PYTHONPATH</key><string>/Users/Shared/apx/autopilot/src</string>
  </dict>
  <key>StartInterval</key><integer>300</integer>
  <key>RunAtLoad</key><true/>
  <key>ProcessType</key><string>Interactive</string>
  <key>StandardOutPath</key><string>/tmp/apx-watch.log</string>
  <key>StandardErrorPath</key><string>/tmp/apx-watch.log</string>
</dict>
</plist>
