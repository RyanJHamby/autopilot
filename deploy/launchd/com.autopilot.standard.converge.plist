<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The OWNER's weekly standard check (a LaunchAgent, runs as you, not as apx). Monday 09:00: it runs `ap standard converge` with its apply flag,
     which audits the portfolio plus repos created in the last 14 days and files, edits or closes ONE `standard-gap` issue per repo.
     It never pushes, never opens a PR, never touches a default branch. It uses your own `gh` login: no token is stored anywhere.
     It runs only from a checkout that is on main with no uncommitted changes to tracked files, and pulls main first: otherwise it prints why and exits.
     If the Mac is asleep at 09:00 launchd runs it on wake. RunAtLoad is false on purpose: installing it files nothing.
     How it went: ~/.autopilot/converge/last.json (ok, counts, errors); the log is /tmp/standard-converge.log.
     Install: replace REPO_DIR with your autopilot checkout, then see docs/standard-converge.md.
       sed "s|REPO_DIR|$PWD|" deploy/launchd/com.autopilot.standard.converge.plist > ~/Library/LaunchAgents/com.autopilot.standard.converge.plist
       launchctl load ~/Library/LaunchAgents/com.autopilot.standard.converge.plist
     Remove:  launchctl unload ~/Library/LaunchAgents/com.autopilot.standard.converge.plist && rm ~/Library/LaunchAgents/com.autopilot.standard.converge.plist -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.autopilot.standard.converge</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>cd REPO_DIR &amp;&amp; { [ "$(git branch --show-current)" = main ] || { echo "converge: REPO_DIR is not on main; not running"; exit 1; }; } &amp;&amp; { [ -z "$(git status --porcelain --untracked-files=no)" ] || { echo "converge: REPO_DIR has uncommitted changes to tracked files; not running"; exit 1; }; } &amp;&amp; git pull --ff-only -q origin main &amp;&amp; uv run ap standard converge --apply</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key><integer>1</integer>
    <key>Hour</key><integer>9</integer>
    <key>Minute</key><integer>0</integer>
  </dict>
  <key>RunAtLoad</key><false/>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>/tmp/standard-converge.log</string>
  <key>StandardErrorPath</key><string>/tmp/standard-converge.log</string>
</dict>
</plist>
