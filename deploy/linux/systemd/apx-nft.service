[Unit]
Description=apx egress allowlist (nftables rules for the three apx accounts)
Documentation=https://github.com/RyanJHamby/autopilot/blob/main/docs/apx-linux-host.md
# Loaded before anything of apx's can start. If this fails, apx.service (which Requires= it) does not run: the host fails closed.
Before=apx.service apx-updater.service
DefaultDependencies=yes

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/usr/sbin/nft -c -f /etc/apx/apx.nft
ExecStart=/usr/sbin/nft -f /etc/apx/apx.nft
ExecReload=/usr/sbin/nft -f /etc/apx/apx.nft
# Stopping never opens egress: it keeps the table and puts the four apx accounts in the lockdown set (every packet of theirs dropped;
# nobody else is matched, so inbound SSH and the admin are untouched). Start or restart reloads the file, which empties the set unless
# /etc/apx-lockdown holds a flag (apx-lockdown on). To remove the rules on purpose, run nft delete table inet apx yourself.
ExecStop=/bin/sh -c '/usr/sbin/nft add element inet apx lockdown { $$(id -u apx), $$(id -u apx-ci), $$(id -u apx-agent), $$(id -u apx-dns) }'

[Install]
WantedBy=multi-user.target
