{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "mcp__claude_ai_*",
      "mcp__plugin_*",
      "mcp__github_comment__*",
      "mcp__github_ci__*",
      "mcp__github_inline_comment__*",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/id_rsa*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Edit(.github/**)",
      "Edit(.autopilot/**)",
      "Edit(.claude/**)",
      "Edit(AGENTS.md)",
      "Edit(CLAUDE.md)",
      "Edit(.mcp.json)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * main*)",
      "Bash(git push * master*)",
      "Bash(git config *signing*)",
      "Bash(git commit * --no-gpg-sign*)",
      "Bash(git commit * -n *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(nc *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(sendmail *)",
      "Bash(mail *)",
      "Bash(gh api *)",
      "Bash(gh release *)",
      "Bash(gh repo *)",
      "Bash(gh secret *)",
      "Bash(gh variable *)",
      "Bash(gh workflow *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr review *)",
      "Bash(gh issue create *)",
      "Bash(gh auth *)",
      "Bash(npm publish*)",
      "Bash(pnpm publish*)",
      "Bash(yarn publish*)",
      "Bash(twine *)",
      "Bash(uv publish*)",
      "Bash(cargo publish*)",
      "Bash(docker push*)",
      "Bash(aws *)",
      "Bash(gcloud *)",
      "Bash(az *)",
      "Bash(vercel *)",
      "Bash(terraform apply*)",
      "Bash(kubectl *)",
      "Bash(printenv*)",
      "Bash(env)",
      "Bash(env *)",
      "Bash(cat *.env*)",
      "WebSearch"
    ]
  }
}
